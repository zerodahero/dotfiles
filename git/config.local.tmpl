# Rendered by mise from the [dotfiles] table -- do NOT edit this file's output
# at ~/.gitconfig.local, because `mise bootstrap` overwrites it.
#
# Change the values in ~/.config/mise/config.local.toml instead:
#
#   [vars]
#   git_name        = "..."
#   git_email       = "..."
#   git_signing_key = "ssh-ed25519 AAAA..."
#
# That file lives outside this repo on purpose. This repo is public.
#
# There are deliberately no `| default(...)` filters below. On a machine with
# no config.local.toml the render fails loudly, rather than writing an empty
# name and producing a confusing git error weeks later.
[user]
    name = {{ vars.git_name }}
    email = {{ vars.git_email }}
    signingkey = {{ vars.git_signing_key }}
[gpg]
    format = ssh
[gpg "ssh"]
{%- if os() == "macos" %}
    program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
{%- else %}
    program = /opt/1Password/op-ssh-sign
{%- endif %}
[commit]
    gpgsign = true
