alias vim=nvim
alias vimdiff='nvim -d'

alias p=project

alias .w='just --justfile ~/.window.justfile --working-directory .'
alias .j='just --justfile ~/.user.justfile --working-directory .'
alias .k='just --justfile ~/.k8s.justfile --working-directory .'
alias .a='just --justfile ~/.aws.justfile --working-directory .'

alias ':q'='exit'

alias please=sudo

##
## Git
##
alias glog="git log --graph --pretty='%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%ad) %C(bold blue)<%an>%Creset' --date=short"
alias git-bc="npx better-commits"
alias gpsup="git push --set-upstream origin $(git-current-branch)"

alias fancy="just --justfile ${PROJECTS}/fancy-docs/justfile"

alias wifichan='system_profiler -json SPAirPortDataType | jq "[.SPAirPortDataType[0].spairport_airport_interfaces[0].spairport_airport_other_local_wireless_networks[].spairport_network_channel] | group_by(.) | map({(.[0]): length}) | add"'

alias claude-serena='claude --system-prompt="$(serena prompts print-cc-system-prompt-override)"'

# vim: ft=zsh sw=2 ts=2 et

