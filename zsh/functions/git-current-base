#
# Prints the ref the current branch forked from, e.g. origin/main
#
# The upstream counts only when it names a different branch, as with
# `git checkout -b feature origin/dev`. git-worktree-add points the upstream at
# the branch's own name on the remote, so after a push it equals HEAD and says
# nothing about the base. Those branches fork from the remote's default branch.
#

local git=${commands[git]}
local branch base

branch=$($git branch --show-current)
base=$($git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)
if [[ -z "$base" || "${base#*/}" == "$branch" ]] \
  || ! $git rev-parse --verify --quiet "$base" >/dev/null; then
  base=$($git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
fi

if [[ -z "$base" ]]; then
  echo "Error: no upstream, and origin/HEAD is not set (fix: git remote set-head origin --auto)" >&2
  return 1
fi

echo $base

