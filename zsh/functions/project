local p=""
local fzf_opts=()
[[ -n "$1" ]] && fzf_opts+=(--query "$1" -1)

p=$(cat <(cat "$HOME/.projects") <(ls "$PROJECTS") | sort | fzf "${fzf_opts[@]}")

if [[ -z $p ]]
then
    echo "No project selected."
	return 1
fi

if [[ $p =~ ^[~/] ]]
then
	cd $p
elif [[ -d $PROJECTS/$p/repo ]]
then
	cd $PROJECTS/$p/repo
else
	cd $PROJECTS/$p
fi

